{
  "name": "@rrlab/ts-plugin",
  "version": "1.3.0",
  "description": "run-run plugin for TypeScript: the typecheck capability, backed by tsc.",
  "homepage": "https://github.com/withvariablelab/dx/tree/main/run-run/ts-plugin#readme",
  "bugs": {
    "url": "https://github.com/withvariablelab/dx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withvariablelab/dx.git",
    "directory": "run-run/ts-plugin"
  },
  "license": "MIT",
  "author": "rcrd <ricardo@variable.land>",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@variablelab/clibuddy": "workspace:*",
    "comment-json": "5.0.0"
  },
  "peerDependencies": {
    "@rrlab/cli": "workspace:^",
    "typescript": ">=5.4.0"
  },
  "devDependencies": {
    "@rrlab/cli": "workspace:*",
    "@rrlab/ts-config": "workspace:^",
    "@rrlab/tsdown-config": "workspace:^",
    "@types/semver": "catalog:",
    "semver": "catalog:",
    "typescript": "catalog:"
  }
}
