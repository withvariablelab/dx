{
  "name": "@rrlab/cli",
  "version": "1.6.0",
  "description": "One way to run the scripts in a repo.",
  "homepage": "https://github.com/withvariablelab/dx/tree/main/run-run/cli#readme",
  "bugs": {
    "url": "https://github.com/withvariablelab/dx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withvariablelab/dx.git",
    "directory": "run-run/cli"
  },
  "license": "MIT",
  "author": "rcrd <ricardo@variable.land>",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "exports": {
    "./config": "./src/lib/config.ts",
    "./plugin": "./src/lib/plugin/index.ts"
  },
  "bin": {
    "rr": "./bin"
  },
  "files": [
    "bin",
    "dist",
    "lefthook",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.*",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./config": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      },
      "./plugin": {
        "types": "./dist/plugin/index.d.mts",
        "default": "./dist/plugin/index.mjs"
      }
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown && pnpm build:kdl",
    "build:kdl": "./bin --usage > dist/cli.usage.kdl",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "prepublishOnly": "pnpm build",
    "tscheck": "rr tsc"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@usage-spec/commander": "1.1.0",
    "@variablelab/clibuddy": "workspace:*",
    "@variablelab/loggy": "workspace:*",
    "commander": "15.0.0",
    "comment-json": "5.0.0",
    "fast-string-width": "3.0.2",
    "glob": "14.0.3",
    "lilconfig": "3.1.4",
    "magicast": "0.5.5",
    "nypm": "0.6.12",
    "rimraf": "6.1.3"
  },
  "devDependencies": {
    "@rrlab/tsdown-config": "workspace:^",
    "tsdown": "catalog:"
  }
}
